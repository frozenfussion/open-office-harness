{
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skill": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed"
      ]
    },
    "output": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file_key": {
              "type": "string",
              "minLength": 1
            },
            "mime": {
              "type": "string"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "file_key",
            "mime",
            "summary"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "skill",
    "status",
    "output",
    "error"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "status": {
          "enum": [
            "completed"
          ]
        },
        "output": {
          "type": "object"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "status": {
          "enum": [
            "failed"
          ]
        },
        "output": {
          "type": "null"
        },
        "error": {
          "type": "object"
        }
      }
    }
  ]
}
