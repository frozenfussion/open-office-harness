{
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "skill.requested",
        "skill.result",
        "approval.requested",
        "approval.decided",
        "audit.event",
        "dlq.entry",
        "chat.message"
      ]
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "type",
    "version",
    "occurred_at",
    "correlation_id",
    "user_id",
    "producer",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "skill.requested"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/skill.requested.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "skill.result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/skill.result.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.requested"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/approval.requested.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.decided"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/approval.decided.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "audit.event"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/audit.event.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dlq.entry"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "payloads/dlq.entry.schema.json"
          }
        }
      }
    }
  ]
}
